# Copy to .env and adjust. `docker compose up` reads this file automatically.

# --- identity ---------------------------------------------------------------
# The surveyed position of the camera on its pole. The platform stores these
# against every sighting, so they are the camera's real coordinates - not the
# vehicle's, and not Null Island (0,0 is the default for both).
CAMERA_ID=cam-01
LAT=12.9716
LON=77.5946
# Optional surveyed attributes of this camera. A single frame cannot tell you which
# way traffic flows past the lens or which lane a car is in, so both are config.
# Omit either to leave it off the payload entirely.
# CAMERA_DIRECTION=E
# CAMERA_LANE=2

# --- input -------------------------------------------------------------------
# Path *inside the container* of the clip this camera "streams".
VIDEO_PATH=/data/cam01.mp4
# Process every Nth frame (1 = every frame).
FRAME_STRIDE=1
# Keep re-reading the clip forever so the demo never ends.
LOOP_VIDEO=true
# Throttle to a simulated frame rate; 0 = run as fast as the CPU allows.
REALTIME_FPS=0
# 0 = no limit.
MAX_FRAMES=0
# Downscale frames wider than this before inference (0 = keep original).
FRAME_MAX_WIDTH=0
# wall = when the container processed the frame, video = VIDEO_START_TIME + clip time.
TIMESTAMP_SOURCE=wall

# --- MQTT --------------------------------------------------------------------
# The topic and the payload keys below are fixed by the platform's
# contract/event_contract.json, not by this repo. ingest validates every message
# against that schema and drops anything that fails, so if you point this node at
# a different backend, change the contract there too - not just this value.
MQTT_BROKER=mosquitto:1883
MQTT_TOPIC_TEMPLATE=anpr/{camera_id}/sightings
MQTT_QOS=1
MQTT_PROTOCOL=v5
# The platform's broker runs authenticated with a per-camera ACL: CAMERA_ID must
# equal the MQTT username, and the ACL must grant it write access to exactly
# anpr/{camera_id}/sightings. Both are blank here because the bundled broker in
# docker-compose.yml is anonymous.
# MQTT_USERNAME=cam-01
# MQTT_PASSWORD=
# MQTT_TLS=false
MQTT_CONNECT_WAIT_SECONDS=30
MQTT_MAX_QUEUE=1000
# Attach region/box metadata as MQTT user properties (payload stays unchanged).
MQTT_PUBLISH_DIAGNOSTICS=false

# --- models ------------------------------------------------------------------
# Baked into the image as an ONNX graph; override only for a different model
VEHICLE_WEIGHTS=/models/yolo26s.onnx
VEHICLE_CLASSES=car,truck,bus,motorcycle
VEHICLE_CONF_THRESHOLD=0.30
VEHICLE_IOU=0.50
VEHICLE_IMGSZ=640
VEHICLE_MAX_DET=20
VEHICLE_MIN_BOX_PX=32
PLATE_MODEL=yolo-v9-t-416-license-plate-end2end
PLATE_SCOPE=crop
PLATE_CONF_THRESHOLD=0.30
OCR_MODEL=cct-s-v2-global-model
OCR_MIN_CONFIDENCE=0.60
PLATE_MIN_LENGTH=5
# Only publish plates matching this regex (e.g. Indian format). Leave empty for all.
# PLATE_PATTERN=^[A-Z]{2}[0-9]{2}[A-Z]{2}[0-9]{4}$

# --- output ------------------------------------------------------------------
# none | path | base64  (controls what image_ref contains)
# The platform treats image_ref as opaque and never fetches it, so `none` is the
# right choice against it. `base64` inlines a JPEG into every MQTT message, which
# no broker here is sized for.
IMAGE_REF_MODE=none
PLATE_IMAGE_DIR=/data/plates
PLATE_IMAGE_MAX_WIDTH=320
PLATE_IMAGE_JPEG_QUALITY=85
# Suppress the same plate seen again within this many seconds.
PLATE_DEDUP_WINDOW_SECONDS=10

# --- logging -----------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
STATS_INTERVAL_SECONDS=30
# ONNX Runtime prints a deprecation notice from C++ on stdout. With this on, the
# logger gets a private copy of fd 1 and native output is dropped, so every line
# of `docker logs` is valid JSON. Set to 0 if you want to see native warnings.
QUIET_ONNX=1

# --- performance -------------------------------------------------------------
INFERENCE_THREADS=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
